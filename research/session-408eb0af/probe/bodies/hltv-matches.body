    if (window.innerWidth < 500) {
        (function () {
            const visibleCalendarMonth = document.querySelector('[data-calendar-month]:not(.hidden)');
            if (!visibleCalendarMonth) return;

            const activeDay = visibleCalendarMonth.querySelector('.calendar-day.active');
            if (!activeDay) return;

            const calendarDates = visibleCalendarMonth.querySelector('.calendar-dates');
            if (!calendarDates) return;

            const allDays = calendarDates.querySelectorAll('.calendar-day:not(.calendar-blank)');
            const singleDayWidth = activeDay.offsetWidth;
            const calendarWidth = singleDayWidth * allDays.length;
            const activeDayPosition = activeDay.offsetLeft;
            const viewportWidth = window.innerWidth;

            let scrollPosition = activeDayPosition - viewportWidth / 2 + singleDayWidth / 2;
            scrollPosition = Math.max(0, Math.min(scrollPosition, calendarWidth - viewportWidth));

            calendarDates.scrollTo(scrollPosition, 0);
        })();
    }
